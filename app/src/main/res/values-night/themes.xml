<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Dark theme, the look the app ships with. Same role mapping as the light
        theme in values/themes.xml, the tokens resolve to the dark palette.
    -->
    <style name="Base.Theme.PROG7314_POE_Backlog_Battler" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_tint</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_elevated</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border</item>
        <item name="colorOutlineVariant">@color/border</item>

        <item name="colorError">@color/destructive</item>
        <item name="android:colorBackground">@color/page_background</item>
        <item name="android:windowBackground">@color/page_background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.AlertDialog</item>
    </style>
</resources>
