<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Light theme. values-night/themes.xml carries the dark twin.
        The colour tokens themselves live in colors.xml, this only maps them
        onto the Material roles so switches, dialogs and ripples follow along.
    -->
    <style name="Base.Theme.PROG7314_POE_Backlog_Battler" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_tint</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_elevated</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border</item>
        <item name="colorOutlineVariant">@color/border</item>

        <item name="colorError">@color/destructive</item>
        <item name="android:colorBackground">@color/page_background</item>
        <item name="android:windowBackground">@color/page_background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.AlertDialog</item>
    </style>

    <style name="Theme.PROG7314_POE_Backlog_Battler" parent="Base.Theme.PROG7314_POE_Backlog_Battler" />

    <!-- the launch splash (core-splashscreen). the system draws it before the app's own
         light/dark choice is known, so it uses the dark page colour the app ships with
         rather than following the phone's theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.PROG7314_POE_Backlog_Battler</item>
    </style>

    <!-- confirmation dialogs (sign out, delete account) and pickers (language, default
         platform) in app colours. the picked radio button takes colorControlActivated,
         which would otherwise be Material's default lilac -->
    <style name="ThemeOverlay.App.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorControlActivated">@color/accent</item>
    </style>
</resources>
