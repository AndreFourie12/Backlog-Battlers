<?xml version="1.0" encoding="utf-8"?>
<!--
    the light palette. values-night/colors.xml holds the dark twin of every
    token below, so Appearance only has to flip AppCompat's night mode.
    accents are darkened from their dark mode values so they still carry
    enough contrast against a near white page.
-->
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Primary Color Palette -->
    <color name="page_background">#FFF4F6FA</color>
    <color name="surface">#FFFFFFFF</color>
    <color name="surface_elevated">#FFEDF1F7</color>
    <color name="border">#FFDDE3EC</color>
    <color name="text_primary">#FF10141C</color>
    <color name="text_secondary">#FF5C6478</color>
    <color name="text_tertiary">#FF8D96AC</color>
    <color name="accent">#FF1479C9</color>
    <color name="on_accent">#FFFFFFFF</color>
    <color name="success">#FF15803D</color>
    <color name="gold">#FFB7791F</color>
    <color name="destructive">#FFD32F3B</color>
    <color name="progress_track">#FFDDE3EC</color>

    <!-- Medal Tier Colors -->
    <color name="medal_gold">#FFB7791F</color>
    <color name="medal_silver">#FF7A8496</color>
    <color name="medal_bronze">#FFA8632C</color>

    <!-- translucent fills. the pills that sit on hero art stay light here so
         the dark text on top of them keeps reading -->
    <color name="scrim_strong">#B8FFFFFF</color>
    <color name="scrim_soft">#C2FFFFFF</color>
    <color name="accent_tint">#141479C9</color>
    <color name="accent_border">#8C1479C9</color>
    <color name="success_tint">#2215803D</color>
    <color name="gold_tint">#22B7791F</color>

    <!-- hero art fades into the page, so these follow page_background -->
    <color name="hero_scrim_top">#4CF4F6FA</color>
    <color name="hero_scrim_clear">#00F4F6FA</color>

    <!-- google sign in button, google brand guidelines -->
    <color name="google_surface">#FFFFFFFF</color>
    <color name="google_on_surface">#FF1F1F1F</color>
    <color name="google_ripple">#1F1F1F1F</color>

    <color name="surface_tile">#FFE8EDF5</color>
</resources>
