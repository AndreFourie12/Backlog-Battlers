    <!-- help and support -->
    <string name="title_help">Help &amp; Support</string>
    <string name="help_section_faq">COMMON QUESTIONS</string>
    <string name="help_faq_points_q">How are points worked out?</string>
    <string name="help_faq_points_a">Every achievement you unlock is worth points based on how rare it is across the community. Rarer achievements are worth more, so finishing a hard game beats grinding an easy one.</string>
    <string name="help_faq_season_q">When does the season reset?</string>
    <string name="help_faq_season_a">Leaderboard points reset on the first day of each month. Your library, playtime and unlocked achievements are kept, only the monthly ranking starts again.</string>
    <string name="help_faq_platform_q">Why is my playtime missing?</string>
    <string name="help_faq_platform_a">Playtime is pulled in when you link a gaming account. Account linking is still being built, so for now you can enter hours yourself on a game\'s detail screen.</string>
    <string name="help_faq_friends_q">How do I add friends?</string>
    <string name="help_faq_friends_a">Open the Friends tab and search for a display name, or send an invite. Once they accept, you both show up on each other\'s monthly leaderboard.</string>



    <!-- about -->
    <string name="title_about">About</string>
    <string name="about_tagline">Clear your backlog. Beat your friends.</string>
    <string name="about_section_app">APP</string>
    <string name="about_section_legal">LEGAL</string>
    <string name="about_version">Version</string>
    <string name="about_build">Build</string>
    <string name="about_build_debug">Debug</string>
    <string name="about_build_release">Release</string>
    <string name="about_blurb">Backlog Battlers tracks the games you own, scores the achievements you unlock, and puts you on a monthly leaderboard against your friends. Built as a PROG7314 portfolio project.</string>
    <string name="about_open_source">Open source licences</string>
    <string name="about_copyright" translatable="false">© 2026 Backlog Battlers</string>
    <string name="about_terms_body">Backlog Battlers is a student portfolio project, provided as is and without warranty. Use it to track your own games. Do not attempt to falsify achievements or leaderboard standings, and do not use the app to harass other players. Accounts that do either may be removed. Because this is a coursework build, features can change or disappear between versions and data is not guaranteed to survive a reinstall.</string>
    <string name="about_privacy_body">Signing in with Google gives the app your display name, email address and profile picture. That, along with your library, playtime, achievements and monthly points, is stored on this device and on the project backend so your leaderboard position is accurate.\n\nYour data is never sold or shared with advertisers. Friends can see your display name, picture, points and recent activity. Nobody can see your email address.\n\nSigning out clears your session and your local copy of your profile from this device.</string>
    <string name="about_licences_body">This app is built on open source work released under the Apache License 2.0:\n\n• AndroidX and Jetpack (Core, AppCompat, Activity, Fragment, Lifecycle, Navigation, Room, DataStore, Security, Credentials)\n• Material Components for Android\n• Kotlin Coroutines and kotlinx.serialization\n• Ktor Client\n\nFull licence texts are available from each project\'s repository.</string>

