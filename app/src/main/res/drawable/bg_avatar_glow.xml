<?xml version="1.0" encoding="utf-8"?>
<!-- the profile avatar: an accent disc inside a soft accent halo -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/accent_tint" />
        </shape>
    </item>
    <item
        android:bottom="7dp"
        android:left="7dp"
        android:right="7dp"
        android:top="7dp">
        <shape android:shape="oval">
            <solid android:color="@color/accent" />
        </shape>
    </item>
</layer-list>
