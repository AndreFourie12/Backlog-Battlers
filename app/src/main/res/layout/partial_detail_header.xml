<?xml version="1.0" encoding="utf-8"?>
<!-- the game detail screen's scrolling header: hero art, title/chips, completion bar, stat
     tiles and the "Achievements" section label. Inflated as the single item of
     GameDetailHeaderAdapter, ahead of the achievement rows in the same RecyclerView - a plain
     wrap_content RecyclerView nested in a ScrollView will not reliably grow past its first
     measured height once a long list is added asynchronously, so the header rides in the same
     list instead of a separate outer ScrollView -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Hero: the game's landscape artwork, with the back and favourite buttons over it -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/hero_height">

        <ImageView
            android:id="@+id/iv_detail_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface_tile"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/detail_hero_scrim_top"
            android:layout_gravity="top"
            android:background="@drawable/scrim_hero_top" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/detail_hero_scrim_bottom"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_hero_bottom" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/page_padding"
            android:paddingEnd="@dimen/page_padding">

            <ImageView
                android:id="@+id/btn_detail_back"
                android:layout_width="@dimen/detail_bar_button"
                android:layout_height="@dimen/detail_bar_button"
                android:background="@drawable/bg_circle_scrim"
                android:contentDescription="@string/cd_back"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_left" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btn_detail_favourite"
                android:layout_width="@dimen/detail_bar_button"
                android:layout_height="@dimen/detail_bar_button"
                android:background="@drawable/bg_circle_scrim"
                android:contentDescription="@string/cd_favourite"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_heart" />
        </LinearLayout>
    </FrameLayout>

    <!-- Title row: box art overlapping the hero, title, platform and genre chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_padding"
        android:layout_marginTop="-20dp"
        android:layout_marginEnd="@dimen/page_padding"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_detail_cover"
            android:layout_width="@dimen/detail_cover_width"
            android:layout_height="@dimen/detail_cover_height"
            android:background="@drawable/bg_art_placeholder_square"
            android:clipToOutline="true"
            android:contentDescription="@string/cd_game_art"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="@dimen/detail_cover_overlap"
            android:layout_weight="1"
            android:gravity="bottom"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_detail_title"
                style="@style/Text.HeroTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                tools:text="Elden Ring" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_detail_platform"
                    style="@style/Text.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_outline"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    tools:text="PS5" />

                <TextView
                    android:id="@+id/tv_detail_genre"
                    style="@style/Text.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_outline"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    tools:text="Action RPG" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Completion -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_padding"
        android:layout_marginTop="@dimen/section_spacing"
        android:layout_marginEnd="@dimen/page_padding"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.SectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="@string/completion" />

            <TextView
                android:id="@+id/tv_detail_completion_percent"
                style="@style/Text.StatValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/accent"
                tools:text="80%" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_detail_completion"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/progress_height"
            android:layout_marginTop="10dp"
            android:max="100"
            android:maxHeight="@dimen/progress_height"
            android:minHeight="@dimen/progress_height"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_accent" />
    </LinearLayout>

    <!-- Points earned, achievements unlocked, average time to beat -->
    <include
        layout="@layout/partial_detail_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_padding"
        android:layout_marginTop="@dimen/section_spacing"
        android:layout_marginEnd="@dimen/page_padding" />

    <!-- Achievements -->
    <TextView
        style="@style/Text.SectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_padding"
        android:layout_marginTop="@dimen/section_spacing"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="@dimen/page_padding"
        android:includeFontPadding="false"
        android:text="@string/achievements" />
</LinearLayout>
