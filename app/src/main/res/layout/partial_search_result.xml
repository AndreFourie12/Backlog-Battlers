<?xml version="1.0" encoding="utf-8"?>
<!--
    what the search screen shows once a search has actually been run: the filters
    that narrow what came back, how many are left, and the results themselves.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:visibility="gone"
    tools:visibility="visible">

    <!-- SearchFragment fills this with the platform, genre and sort chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/page_padding"
        android:paddingEnd="@dimen/page_padding"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/container_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tv_result_count"
        style="@style/Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_padding"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="@dimen/page_padding"
        android:includeFontPadding="false"
        tools:text="3 results" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="@dimen/page_padding"
            android:paddingTop="10dp"
            android:paddingEnd="@dimen/page_padding"
            android:paddingBottom="@dimen/bottom_content_inset"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="3"
            tools:listitem="@layout/item_search_result" />

        <ProgressBar
            android:id="@+id/progress_results"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:indeterminateTint="@color/accent"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- stands in for the list when the search found nothing, the filters
             left nothing, or the catalogue could not be reached -->
        <LinearLayout
            android:id="@+id/state_results_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_padding"
            android:paddingEnd="@dimen/page_padding"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_results_message"
                style="@style/Text.BodyStrong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                tools:text="No games match “zzzz”" />

            <TextView
                android:id="@+id/tv_results_message_body"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                tools:text="Check the spelling, or try a shorter title." />

            <TextView
                android:id="@+id/btn_retry_results"
                style="@style/Text.SectionAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:includeFontPadding="false"
                android:padding="6dp"
                android:text="@string/try_again"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
