<?xml version="1.0" encoding="utf-8"?>
<!-- the row under the feed that stands in for it while it loads, when it is empty or when it failed to load -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_padding"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/page_padding"
    android:paddingBottom="12dp">

    <ProgressBar
        android:id="@+id/progress_status"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/card_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/empty_state_tile"
                android:layout_height="@dimen/empty_state_tile"
                android:background="@drawable/bg_tile_surface"
                android:contentDescription="@null"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pulse"
                app:tint="@color/accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_status_title"
                    style="@style/Text.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/activity_empty_title" />

                <TextView
                    android:id="@+id/tv_status_body"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_status_retry"
            style="@style/Widget.App.AccentButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cta_height"
            android:layout_marginTop="15dp"
            android:text="@string/try_again"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
