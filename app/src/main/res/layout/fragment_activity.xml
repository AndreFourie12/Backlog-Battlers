<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical"
    tools:context=".fragments.ActivityFragment">

    <!-- Wordmark Bar: logo, app name and the settings gear -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_padding"
        android:paddingEnd="@dimen/page_padding">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/cd_app_logo"
            android:src="@drawable/img_logo_mark" />

        <TextView
            style="@style/Text.Wordmark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:text="@string/wordmark"
            android:textColor="@color/text_secondary" />

        <ImageView
            android:id="@+id/btn_settings"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_settings"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_gear"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Pull down to refresh. The title, the standings card, the feed and its loading, empty and
         error rows are all one list (see ActivityFeedAdapter), so they scroll together -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_activity"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/bottom_content_inset"
            tools:listitem="@layout/item_activity_event" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
