<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none"
    tools:context=".fragments.ActivityFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/bottom_content_inset">

        <!-- Wordmark Bar: logo, app name and the settings gear -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/page_padding"
            android:paddingEnd="@dimen/page_padding">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/cd_app_logo"
                android:src="@drawable/img_logo_mark" />

            <TextView
                style="@style/Text.Wordmark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="@string/wordmark"
                android:textColor="@color/text_secondary" />

            <ImageView
                android:id="@+id/btn_settings"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_settings"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_gear"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Screen Title -->
        <TextView
            style="@style/Text.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_padding"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/page_padding"
            android:includeFontPadding="false"
            android:text="@string/title_activity" />

        <!-- Standings Empty State Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_padding"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="@dimen/page_padding"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/empty_state_tile"
                    android:layout_height="@dimen/empty_state_tile"
                    android:background="@drawable/bg_tile_surface"
                    android:contentDescription="@null"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_trophy"
                    app:tint="@color/gold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/activity_no_standings_title" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/activity_no_standings_body" />
                </LinearLayout>
            </LinearLayout>

            <!-- the only wired control on this screen: opens the leaderboard -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_view_standings"
                style="@style/Widget.App.AccentButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cta_height"
                android:layout_marginTop="15dp"
                android:text="@string/view_standings"
                app:icon="@drawable/ic_arrow_right" />
        </LinearLayout>

        <!-- Day Grouping Header -->
        <TextView
            style="@style/Text.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_padding"
            android:layout_marginTop="@dimen/section_spacing"
            android:layout_marginEnd="@dimen/page_padding"
            android:includeFontPadding="false"
            android:text="@string/activity_today" />

        <!-- Joined Event Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_padding"
            android:layout_marginTop="11dp"
            android:layout_marginEnd="@dimen/page_padding"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_circle_accent"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/profile_avatar_initial"
                android:textColor="@color/on_accent"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/activity_event_joined"
                    android:textColor="@color/text_primary" />

                <TextView
                    style="@style/Text.Micro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:text="@string/activity_just_now" />
            </LinearLayout>

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_tile_surface"
                android:contentDescription="@null"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/img_logo_mark" />
        </LinearLayout>

        <!-- What Will Appear Here Hint -->
        <TextView
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_padding"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="@dimen/page_padding"
            android:includeFontPadding="false"
            android:lineSpacingExtra="4dp"
            android:text="@string/activity_feed_hint"
            android:textColor="@color/text_tertiary" />
    </LinearLayout>
</ScrollView>
