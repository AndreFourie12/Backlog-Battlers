<?xml version="1.0" encoding="utf-8"?>
<!-- one row: either a loading spinner or a retry prompt, standing in for the achievement rows
     while they load or if the request failed. Item of AchievementStatusAdapter -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/page_padding"
    android:layout_marginEnd="@dimen/page_padding">

    <ProgressBar
        android:id="@+id/progress_detail_achievements"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:indeterminateTint="@color/accent" />

    <LinearLayout
        android:id="@+id/state_detail_achievements_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/achievements_error" />

        <TextView
            android:id="@+id/btn_retry_achievements"
            style="@style/Text.SectionAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:includeFontPadding="false"
            android:padding="6dp"
            android:text="@string/try_again" />
    </LinearLayout>
</FrameLayout>
