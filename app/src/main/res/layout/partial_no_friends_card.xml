<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:padding="@dimen/card_padding">

    <!-- Empty State Title -->
    <TextView
        android:id="@+id/tv_empty_title"
        style="@style/Text.CardTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/no_friends_yet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="@string/no_friends_title_empty" />

    <!-- Empty State Body -->
    <TextView
        android:id="@+id/tv_empty_body"
        style="@style/Text.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/no_friends_body"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_empty_title"
        tools:text="@string/no_friends_body_empty" />

    <!-- Share Invite Link Button -->
    <Button
        android:id="@+id/btn_share_invite"
        style="@style/Text.CaptionStrong"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_button_accent"
        android:text="@string/share_invite_link"
        android:textColor="@color/page_background"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_empty_body"
        tools:visibility="visible" />

    <!-- Find By Username Button -->
    <Button
        android:id="@+id/btn_find_by_username"
        style="@style/Text.CaptionStrong"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pill_outline"
        android:text="@string/find_by_username"
        android:textColor="@color/text_primary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_share_invite"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>