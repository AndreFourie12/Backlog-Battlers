<?xml version="1.0" encoding="utf-8"?>
<!--
    one picture in the picker: a circle, ringed in the accent colour with a tick when it is the one picked.
    the outer frame centres the fixed-size circle in its grid cell, so it is not useless
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    tools:ignore="UselessParent">

    <FrameLayout
        android:layout_width="@dimen/profile_picture_option"
        android:layout_height="@dimen/profile_picture_option"
        android:layout_gravity="center_horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivProfilePictureOption"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface_tile"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="3dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circle"
            app:strokeColor="@color/accent"
            app:strokeWidth="0dp" />

        <ImageView
            android:id="@+id/ivProfilePictureCheck"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_profile_picture_check"
            android:contentDescription="@null"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            app:tint="@color/on_accent" />
    </FrameLayout>
</FrameLayout>
