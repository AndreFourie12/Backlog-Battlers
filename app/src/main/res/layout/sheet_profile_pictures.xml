<?xml version="1.0" encoding="utf-8"?>
<!-- the bottom sheet "Change photo" opens: a grid of the pictures a user can pick -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_padding"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/page_padding"
    android:paddingBottom="@dimen/bottom_content_inset">

    <!-- drag handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        style="@style/Text.CardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:includeFontPadding="false"
        android:text="@string/edit_profile_picker_title" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listProfilePictures"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:overScrollMode="never"
        tools:itemCount="8"
        tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        tools:listitem="@layout/item_profile_picture"
        tools:spanCount="4" />

    <TextView
        android:id="@+id/tvProfilePicturesEmpty"
        style="@style/Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:text="@string/edit_profile_picker_empty"
        android:textColor="@color/text_tertiary"
        android:visibility="gone" />
</LinearLayout>
