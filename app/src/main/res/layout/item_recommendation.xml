<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/img_game_art"
        android:layout_width="@dimen/recommendation_thumb_width"
        android:layout_height="@dimen/recommendation_thumb_height"
        android:background="@drawable/bg_art_placeholder"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/img_add_badge"
        android:layout_width="@dimen/recommendation_badge"
        android:layout_height="@dimen/recommendation_badge"
        android:layout_marginTop="@dimen/recommendation_badge_inset"
        android:layout_marginEnd="@dimen/recommendation_badge_inset"
        android:background="@drawable/bg_circle_scrim"
        android:importantForAccessibility="no"
        android:padding="5dp"
        android:src="@drawable/ic_plus"
        app:layout_constraintEnd_toEndOf="@id/img_game_art"
        app:layout_constraintTop_toTopOf="@id/img_game_art"
        app:tint="@color/text_primary"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/tv_game_title"
        style="@style/Text.CardTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="2"
        app:layout_constraintBottom_toTopOf="@id/tv_game_reason"
        app:layout_constraintEnd_toStartOf="@id/img_chevron"
        app:layout_constraintStart_toEndOf="@id/img_game_art"
        app:layout_constraintTop_toTopOf="@id/img_game_art"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Sekiro: Shadows Die Twice" />

    <TextView
        android:id="@+id/tv_game_reason"
        style="@style/Text.Caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="@id/img_game_art"
        app:layout_constraintEnd_toEndOf="@id/tv_game_title"
        app:layout_constraintStart_toStartOf="@id/tv_game_title"
        app:layout_constraintTop_toBottomOf="@id/tv_game_title"
        tools:text="Highly rated by the community" />

    <ImageView
        android:id="@+id/img_chevron"
        android:layout_width="@dimen/recommendation_chevron"
        android:layout_height="@dimen/recommendation_chevron"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        app:layout_constraintBottom_toBottomOf="@id/tv_game_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_game_title"
        app:tint="@color/text_tertiary"
        tools:ignore="ContentDescription" />
</androidx.constraintlayout.widget.ConstraintLayout>
