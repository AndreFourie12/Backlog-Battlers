<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    tools:context=".fragments.ProfileFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/bottom_content_inset">

            <!-- Wordmark Bar: logo, app name, edit profile and settings gear -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/page_padding"
                android:paddingEnd="@dimen/page_padding">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/cd_app_logo"
                    android:src="@drawable/img_logo_mark" />

                <TextView
                    style="@style/Text.Wordmark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="@string/wordmark"
                    android:textColor="@color/text_secondary" />

                <ImageView
                    android:id="@+id/btn_edit_profile"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/title_edit_profile"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pencil"
                    app:tint="@color/text_secondary" />

                <ImageView
                    android:id="@+id/btn_settings"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_settings"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_gear"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <!-- Identity Header: avatar, name, level and XP progress. the level and XP wait for the profile -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/page_padding"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="@dimen/page_padding"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <include
                    android:id="@+id/avatarProfile"
                    layout="@layout/partial_profile_avatar"
                    android:layout_width="@dimen/settings_avatar"
                    android:layout_height="@dimen/settings_avatar" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProfileName"
                        style="@style/Text.HeroTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        tools:text="Dylan" />

                    <LinearLayout
                        android:id="@+id/group_xp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@null"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_trophy"
                                app:tint="@color/gold" />

                            <TextView
                                android:id="@+id/tv_level"
                                style="@style/Text.BodyStrong"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="7dp"
                                android:includeFontPadding="false"
                                android:textColor="@color/gold"
                                tools:text="Level 3" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progress_xp"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/progress_height"
                            android:layout_marginTop="11dp"
                            android:max="100"
                            android:maxHeight="@dimen/progress_height"
                            android:minHeight="@dimen/progress_height"
                            android:progress="0"
                            android:progressDrawable="@drawable/progress_bar_accent" />

                        <TextView
                            android:id="@+id/tv_xp_progress"
                            style="@style/Text.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:includeFontPadding="false"
                            tools:text="250 / 400 XP" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Loading, shown until the profile arrives -->
            <ProgressBar
                android:id="@+id/progress_profile"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="40dp" />

            <!-- Error, shown instead of the sections when the profile could not be loaded -->
            <LinearLayout
                android:id="@+id/card_profile_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/page_padding"
                android:layout_marginTop="@dimen/section_spacing"
                android:layout_marginEnd="@dimen/page_padding"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    style="@style/Text.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/profile_error_title" />

                <TextView
                    android:id="@+id/tv_profile_error"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/profile_error_load" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_profile_retry"
                    style="@style/Widget.App.AccentButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cta_height"
                    android:layout_marginTop="15dp"
                    android:text="@string/try_again" />
            </LinearLayout>

            <!-- Everything the backend works out. hidden until there is a profile -->
            <LinearLayout
                android:id="@+id/content_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Badges Card: the first four (earned ones first), and See all opens the whole set -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/page_padding"
                    android:layout_marginTop="@dimen/section_spacing"
                    android:layout_marginEnd="@dimen/page_padding"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Text.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="@string/badges" />

                        <TextView
                            android:id="@+id/tv_badges_earned"
                            style="@style/Text.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:includeFontPadding="false"
                            android:textColor="@color/text_tertiary"
                            tools:text="6 of 20 earned" />

                        <LinearLayout
                            android:id="@+id/btn_badges_see_all"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="32dp"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/Text.SectionAction"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/profile_see_all" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@null"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/accent" />
                        </LinearLayout>
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_badges"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        tools:itemCount="4"
                        tools:listitem="@layout/item_badge" />
                </LinearLayout>

                <!-- Rarest Achievement Showcase Card: two rows of seven slots, the rarest unlocks first -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/page_padding"
                    android:layout_marginTop="@dimen/section_gap"
                    android:layout_marginEnd="@dimen/page_padding"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Text.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/showcase_title" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_showcase"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        tools:itemCount="14"
                        tools:listitem="@layout/item_showcase_tile" />

                </LinearLayout>

                <!-- Recent Activity: the games the user unlocked achievements in during the last two weeks -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/page_padding"
                    android:layout_marginTop="@dimen/section_spacing"
                    android:layout_marginEnd="@dimen/page_padding"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:text="@string/profile_recent_title" />

                    <TextView
                        android:id="@+id/tv_recent_window"
                        style="@style/Text.Micro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:includeFontPadding="false"
                        tools:text="9 unlocked past 2 weeks" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/list_recent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/page_padding"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="@dimen/page_padding"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/row_recent_empty"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/page_padding"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="@dimen/page_padding"
                    android:background="@drawable/bg_card"
                    android:includeFontPadding="false"
                    android:padding="20dp"
                    android:text="@string/profile_recent_empty"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
