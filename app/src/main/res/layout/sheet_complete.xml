<?xml version="1.0" encoding="utf-8"?>
<!-- the bottom sheet "Mark as complete" opens on a game: the two ways to complete it. one that is not
     possible (yet) is dimmed, and its hint says what is missing -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_padding"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/page_padding"
    android:paddingBottom="@dimen/bottom_content_inset">

    <!-- drag handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        style="@style/Text.CardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:includeFontPadding="false"
        android:text="@string/complete_sheet_title" />

    <!-- Story -->
    <LinearLayout
        android:id="@+id/row_complete_story"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/card_padding">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_tile_surface"
            android:contentDescription="@null"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_check"
            app:tint="@color/success" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Text.BodyStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/complete_story_title" />

            <TextView
                android:id="@+id/tv_complete_story_hint"
                style="@style/Text.Micro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                tools:text="You finished the main story." />
        </LinearLayout>
    </LinearLayout>

    <!-- 100% -->
    <LinearLayout
        android:id="@+id/row_complete_full"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/card_padding">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_tile_surface"
            android:contentDescription="@null"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_trophy"
            app:tint="@color/gold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Text.BodyStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/complete_hundred_title" />

            <TextView
                android:id="@+id/tv_complete_full_hint"
                style="@style/Text.Micro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                tools:text="Every achievement is unlocked. Steam will confirm each one." />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
