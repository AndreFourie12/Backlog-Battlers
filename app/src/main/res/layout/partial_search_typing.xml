<?xml version="1.0" encoding="utf-8"?>
<!--
    what the search screen shows while the user is still typing: the option to
    run the search as typed, and the first few matches the API found for it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:visibility="gone"
    tools:visibility="visible">

    <!-- tapping this runs the full search for exactly what was typed -->
    <LinearLayout
        android:id="@+id/row_search_for"
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_row_height"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_padding"
        android:paddingEnd="@dimen/page_padding">

        <ImageView
            android:layout_width="@dimen/search_row_icon"
            android:layout_height="@dimen/search_row_icon"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search"
            app:tint="@color/text_tertiary" />

        <TextView
            android:id="@+id/tv_search_for"
            style="@style/Text.SearchPrompt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Search for “hollow”" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_suggestions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/bottom_content_inset"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="2"
            tools:listitem="@layout/item_search_suggestion" />

        <ProgressBar
            android:id="@+id/progress_suggestions"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:indeterminateTint="@color/accent"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_suggestions_message"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_horizontal"
            android:paddingStart="@dimen/page_padding"
            android:paddingEnd="@dimen/page_padding"
            android:visibility="gone"
            tools:text="Couldn’t reach the game catalogue."
            tools:visibility="visible" />
    </FrameLayout>
</LinearLayout>
