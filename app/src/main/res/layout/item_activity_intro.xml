<?xml version="1.0" encoding="utf-8"?>
<!-- the top of the activity list: the screen title and the card that opens the leaderboard -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Text.ScreenTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_padding"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="@dimen/page_padding"
        android:includeFontPadding="false"
        android:text="@string/title_activity" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_padding"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="@dimen/page_padding"
        android:layout_marginBottom="@dimen/section_spacing"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/empty_state_tile"
                android:layout_height="@dimen/empty_state_tile"
                android:background="@drawable/bg_tile_surface"
                android:contentDescription="@null"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_trophy"
                app:tint="@color/gold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/activity_standings_title" />

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/activity_standings_body" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_view_standings"
            style="@style/Widget.App.AccentButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cta_height"
            android:layout_marginTop="15dp"
            android:text="@string/view_standings"
            app:icon="@drawable/ic_arrow_right" />
    </LinearLayout>
</LinearLayout>
