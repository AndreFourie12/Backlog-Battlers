<?xml version="1.0" encoding="utf-8"?>
<!--
    edit profile: the picture, the display name and which profile sections friends see.
    everything here is a draft until Save in the top bar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".fragments.EditProfileFragment">

    <!-- top bar: back, title, save -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/btnEditProfileBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/text_primary" />

        <TextView
            style="@style/Text.BarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/title_edit_profile" />

        <TextView
            android:id="@+id/btnSaveProfile"
            style="@style/Text.SectionAction"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/edit_profile_save"
            android:textSize="15sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/bottom_content_inset">

            <!-- avatar, with the camera button over its lower right edge -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="26dp">

                <include
                    android:id="@+id/avatarEditProfile"
                    layout="@layout/partial_profile_avatar"
                    android:layout_width="@dimen/edit_profile_avatar"
                    android:layout_height="@dimen/edit_profile_avatar" />

                <ImageView
                    android:id="@+id/btnAvatarCamera"
                    android:layout_width="@dimen/avatar_badge"
                    android:layout_height="@dimen/avatar_badge"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_avatar_badge"
                    android:contentDescription="@string/cd_change_photo"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/text_primary" />
            </FrameLayout>

            <!-- change photo | remove -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnChangePhoto"
                    style="@style/Text.SectionAction"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/edit_profile_change_photo"
                    android:textSize="14sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/border" />

                <TextView
                    android:id="@+id/btnRemovePhoto"
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/edit_profile_remove_photo"
                    android:textColor="@color/text_tertiary" />
            </LinearLayout>

            <!-- DISPLAY NAME -->
            <include
                android:id="@+id/headerDisplayName"
                layout="@layout/item_settings_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/page_padding"
                android:layout_marginEnd="@dimen/page_padding" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/page_padding"
                android:layout_marginEnd="@dimen/page_padding"
                android:addStatesFromChildren="true"
                android:background="@drawable/bg_field_focusable"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <EditText
                    android:id="@+id/etDisplayName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/edit_profile_display_name_hint"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="20"
                    android:maxLines="1"
                    android:minHeight="50dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:textSize="15sp"
                    tools:text="Alex" />

                <TextView
                    android:id="@+id/tvDisplayNameCount"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_tertiary"
                    tools:text="4 / 20" />
            </LinearLayout>

            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/page_padding"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="@dimen/page_padding"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:text="@string/edit_profile_name_helper"
                android:textColor="@color/text_tertiary" />

            <!-- SHOWN ON YOUR PROFILE -->
            <include
                android:id="@+id/headerShownOnProfile"
                layout="@layout/item_settings_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/page_padding"
                android:layout_marginEnd="@dimen/page_padding" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/page_padding"
                android:layout_marginEnd="@dimen/page_padding"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="@dimen/card_padding"
                android:paddingTop="2dp"
                android:paddingEnd="@dimen/card_padding"
                android:paddingBottom="2dp">

                <include
                    android:id="@+id/toggleShowBadges"
                    layout="@layout/item_settings_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    layout="@layout/partial_settings_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/toggleShowShowcase"
                    layout="@layout/item_settings_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/page_padding"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="@dimen/page_padding"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:text="@string/edit_profile_visibility_note"
                android:textColor="@color/text_tertiary" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
