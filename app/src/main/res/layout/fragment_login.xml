<?xml version="1.0" encoding="utf-8"?>
<!-- sign in screen: pixel art hero up top, brand block under it, sso block pinned
     to the bottom with the slack between them taken by a weighted spacer so the
     screen still scrolls on short devices -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none"
    tools:context=".fragments.LoginFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- artwork runs edge to edge behind the status bar and is faded into the
             page background at both ends by the two scrims -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/login_hero_height">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/img_login_backdrop"
                tools:ignore="ContentDescription" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/login_hero_scrim_top"
                android:layout_gravity="top"
                android:background="@drawable/scrim_login_hero_top" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/login_hero_scrim_bottom"
                android:layout_gravity="bottom"
                android:background="@drawable/scrim_login_hero_bottom" />
        </FrameLayout>

        <ImageView
            android:id="@+id/iv_login_logo"
            android:layout_width="@dimen/login_logo_width"
            android:layout_height="@dimen/login_logo_height"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/cd_app_logo"
            android:src="@drawable/img_logo_mark" />

        <TextView
            android:id="@+id/tv_login_title"
            style="@style/Text.LoginWordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="17dp"
            android:text="@string/wordmark" />

        <TextView
            android:id="@+id/tv_login_subtitle"
            style="@style/Text.LoginTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="@dimen/login_page_padding"
            android:layout_marginTop="13dp"
            android:layout_marginEnd="@dimen/login_page_padding"
            android:maxWidth="@dimen/login_tagline_max_width"
            android:text="@string/login_tagline" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/login_page_padding"
            android:paddingEnd="@dimen/login_page_padding"
            android:paddingBottom="@dimen/login_page_padding">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_google_sign_in"
                    style="@style/Widget.App.GoogleButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/login_button_height"
                    android:text="@string/login_continue_with_google" />

                <!-- sits on top of the button, which sheds its label while it spins -->
                <ProgressBar
                    android:id="@+id/progress_bar_loading"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/google_on_surface"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_login_account_hint"
                style="@style/Text.LoginHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/login_account_hint" />

            <TextView
                android:id="@+id/tv_login_terms"
                style="@style/Text.LoginTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                tools:text="@string/login_terms_notice" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>