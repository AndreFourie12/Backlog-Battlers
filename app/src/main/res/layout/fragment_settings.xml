<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none"
    tools:context=".fragments.SettingsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/bottom_content_inset">

        <include
            android:id="@+id/barSettings"
            layout="@layout/partial_settings_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- ACCOUNT -->
        <include
            android:id="@+id/headerAccount"
            layout="@layout/item_settings_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_padding"
            android:layout_marginEnd="@dimen/page_padding" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_padding"
            android:layout_marginEnd="@dimen/page_padding"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="@dimen/card_padding"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/card_padding"
            android:paddingBottom="4dp">

            <include
                android:id="@+id/rowEditProfile"
                layout="@layout/item_settings_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_row_height" />

            <include
                android:id="@+id/dividerAccount"
                layout="@layout/partial_settings_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp" />

            <include
                android:id="@+id/rowConnectedAccounts"
                layout="@layout/item_settings_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_row_height" />
        </LinearLayout>

        <!-- PREFERENCES -->
        <include
            android:id="@+id/headerPreferences"
            layout="@layout/item_settings_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_padding"
            android:layout_marginEnd="@dimen/page_padding" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_padding"
            android:layout_marginEnd="@dimen/page_padding"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="@dimen/card_padding"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/card_padding"
            android:paddingBottom="4dp">

            <include
                android:id="@+id/rowNotifications"
                layout="@layout/item_settings_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_row_height" />

            <include
                android:id="@+id/dividerPreferences"
                layout="@layout/partial_settings_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp" />

            <include
                android:id="@+id/rowAppearance"
                layout="@layout/item_settings_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_row_height" />

            <include
                android:id="@+id/dividerPreferencesTwo"
                layout="@layout/partial_settings_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp" />

            <include
                android:id="@+id/rowDefaultPlatform"
                layout="@layout/item_settings_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_row_height" />
        </LinearLayout>

        <!-- SUPPORT -->
        <include
            android:id="@+id/headerSupport"
            layout="@layout/item_settings_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_padding"
            android:layout_marginEnd="@dimen/page_padding" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_padding"
            android:layout_marginEnd="@dimen/page_padding"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="@dimen/card_padding"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/card_padding"
            android:paddingBottom="4dp">

            <include
                android:id="@+id/rowPrivacy"
                layout="@layout/item_settings_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_row_height" />

            <include
                android:id="@+id/dividerSupportOne"
                layout="@layout/partial_settings_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp" />

            <include
                android:id="@+id/rowHelp"
                layout="@layout/item_settings_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_row_height" />

            <include
                android:id="@+id/dividerSupportTwo"
                layout="@layout/partial_settings_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp" />

            <include
                android:id="@+id/rowAbout"
                layout="@layout/item_settings_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_row_height" />
        </LinearLayout>

        <!-- LOG OUT -->
        <LinearLayout
            android:id="@+id/btnLogOut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_padding"
            android:layout_marginTop="@dimen/section_spacing"
            android:layout_marginEnd="@dimen/page_padding"
            android:background="@drawable/bg_card_destructive"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="@dimen/settings_row_height"
            android:orientation="horizontal"
            android:paddingStart="@dimen/card_padding"
            android:paddingTop="13dp"
            android:paddingEnd="@dimen/card_padding"
            android:paddingBottom="13dp">

            <ImageView
                android:layout_width="@dimen/settings_row_icon"
                android:layout_height="@dimen/settings_row_icon"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_logout"
                app:tint="@color/destructive" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="@string/log_out"
                android:textColor="@color/destructive" />
        </LinearLayout>

        <!-- DELETE ACCOUNT -->
        <LinearLayout
            android:id="@+id/btnDeleteAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_padding"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="@dimen/page_padding"
            android:background="@drawable/bg_card_destructive"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="@dimen/settings_row_height"
            android:orientation="horizontal"
            android:paddingStart="@dimen/card_padding"
            android:paddingTop="13dp"
            android:paddingEnd="@dimen/card_padding"
            android:paddingBottom="13dp">

            <ImageView
                android:layout_width="@dimen/settings_row_icon"
                android:layout_height="@dimen/settings_row_icon"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_trash"
                app:tint="@color/destructive" />

            <TextView
                android:id="@+id/tvDeleteAccount"
                style="@style/Text.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="@string/delete_account"
                android:textColor="@color/destructive" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
