<?xml version="1.0" encoding="utf-8"?>
<!--
    one outlined pill, e.g. a genre under "Browse by genre". SearchFragment
    inflates one of these per browse category and sets its label.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Text.Chip"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/search_chip_height"
    android:background="@drawable/bg_pill_outline"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    tools:text="Action" />
