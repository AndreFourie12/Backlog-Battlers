<?xml version="1.0" encoding="utf-8"?>
<!-- the same rule as data_extraction_rules.xml, for Android 11 and older: back everything up except the
     encrypted signed-in session, which can't be decrypted on another phone.
     https://developer.android.com/identity/data/autobackup#IncludingFiles -->
<full-backup-content>
    <exclude domain="sharedpref" path="secure_token_prefs.xml" />
    <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
</full-backup-content>
