<?xml version="1.0" encoding="utf-8"?>
<!-- what Android 12+ backs up to the cloud and copies to a new phone. everything is included except the
     signed-in session: secure_token_prefs is encrypted with a key that never leaves this phone's keystore,
     so a restored copy can't be decrypted on another phone. the user simply signs in again there.
     __androidx_security_crypto_encrypted_prefs__ holds that file's encryption keys.
     https://developer.android.com/identity/data/autobackup#include-exclude-android-12 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_token_prefs.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_token_prefs.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </device-transfer>
</data-extraction-rules>
