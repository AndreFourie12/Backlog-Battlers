<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@+id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.backlogbattlers.app.fragments.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_biometricLockFragment"
            app:destination="@id/biometricLockFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.backlogbattlers.app.fragments.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- the five bottom navigation destinations -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.backlogbattlers.app.fragments.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_standingsFragment"
            app:destination="@id/standingsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_searchFragment"
            app:destination="@id/searchFragment" />
        <action
            android:id="@+id/action_homeFragment_to_gameDetailFragment"
            app:destination="@id/gameDetailFragment" />
        <action
            android:id="@+id/action_homeFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/gamesFragment"
        android:name="com.backlogbattlers.app.fragments.GamesFragment"
        android:label="Games"
        tools:layout="@layout/fragment_games">
        <action
            android:id="@+id/action_gamesFragment_to_gameDetailFragment"
            app:destination="@id/gameDetailFragment" />
        <action
            android:id="@+id/action_gamesFragment_to_searchFragment"
            app:destination="@id/searchFragment" />
    </fragment>

    <fragment
        android:id="@+id/activityFragment"
        android:name="com.backlogbattlers.app.fragments.ActivityFragment"
        android:label="Activity"
        tools:layout="@layout/fragment_activity">
        <action
            android:id="@+id/action_activityFragment_to_standingsFragment"
            app:destination="@id/standingsFragment" />
        <action
            android:id="@+id/action_activityFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
        <action
            android:id="@+id/action_activityFragment_to_gameDetailFragment"
            app:destination="@id/gameDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/friendsFragment"
        android:name="com.backlogbattlers.app.fragments.FriendsFragment"
        android:label="Friends"
        tools:layout="@layout/fragment_friends">
        <action
            android:id="@+id/action_friendsFragment_to_findFriendsFragment"
            app:destination="@id/findFriendsFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.backlogbattlers.app.fragments.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
        <action
            android:id="@+id/action_profileFragment_to_gameDetailFragment"
            app:destination="@id/gameDetailFragment" />
    </fragment>

    <!-- drill downs, these hide the bottom navigation while they are open -->
    <fragment
        android:id="@+id/gameDetailFragment"
        android:name="com.backlogbattlers.app.fragments.GameDetailFragment"
        android:label="Game Detail"
        tools:layout="@layout/fragment_game_detail">
        <argument
            android:name="gameId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/standingsFragment"
        android:name="com.backlogbattlers.app.fragments.StandingsFragment"
        android:label="Leaderboard"
        tools:layout="@layout/fragment_standings" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.backlogbattlers.app.fragments.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settingsFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_notificationSettingsFragment"
            app:destination="@id/notificationSettingsFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_appearanceFragment"
            app:destination="@id/appearanceFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_privacyDataFragment"
            app:destination="@id/privacyDataFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_helpSupportFragment"
            app:destination="@id/helpSupportFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_aboutFragment"
            app:destination="@id/aboutFragment" />
        <!-- signing out clears the back stack so back cannot return to the app -->
        <action
            android:id="@+id/action_settingsFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- the screens behind each settings row -->
    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.backlogbattlers.app.fragments.EditProfileFragment"
        android:label="Edit Profile"
        tools:layout="@layout/fragment_edit_profile" />

    <fragment
        android:id="@+id/notificationSettingsFragment"
        android:name="com.backlogbattlers.app.fragments.NotificationSettingsFragment"
        android:label="Notifications"
        tools:layout="@layout/fragment_notification_settings" />

    <fragment
        android:id="@+id/appearanceFragment"
        android:name="com.backlogbattlers.app.fragments.AppearanceFragment"
        android:label="Appearance"
        tools:layout="@layout/fragment_appearance" />

    <fragment
        android:id="@+id/privacyDataFragment"
        android:name="com.backlogbattlers.app.fragments.PrivacyDataFragment"
        android:label="Privacy and Data"
        tools:layout="@layout/fragment_privacy_data" />

    <fragment
        android:id="@+id/helpSupportFragment"
        android:name="com.backlogbattlers.app.fragments.HelpSupportFragment"
        android:label="Help and Support"
        tools:layout="@layout/fragment_help_support" />

    <fragment
        android:id="@+id/aboutFragment"
        android:name="com.backlogbattlers.app.fragments.AboutFragment"
        android:label="About"
        tools:layout="@layout/fragment_about" />

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.backlogbattlers.app.fragments.SearchFragment"
        android:label="Search"
        tools:layout="@layout/fragment_search">
        <action
            android:id="@+id/action_searchFragment_to_gameDetailFragment"
            app:destination="@id/gameDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/findFriendsFragment"
        android:name="com.backlogbattlers.app.fragments.FindFriendsFragment"
        android:label="Find Friends"
        tools:layout="@layout/fragment_find_friends" />

    <fragment
        android:id="@+id/biometricLockFragment"
        android:name="com.backlogbattlers.app.fragments.BiometricLockFragment"
        android:label="Biometric Lock"
        tools:layout="@layout/fragment_biometric_lock">
        <action
            android:id="@+id/action_biometricLockFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/biometricLockFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_biometricLockFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
